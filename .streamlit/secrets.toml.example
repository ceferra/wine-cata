# Copy to .streamlit/secrets.toml (local) or paste in Streamlit Cloud > Settings > Secrets.
# Everything is optional.

# Enables AI search and label recognition.
OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o"

# Persistent database. Without it data lives in lacata.db, which Streamlit Cloud wipes on restart.
# Free Postgres: Supabase or Neon. Example:
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"

# If set, creating a new tasting asks for this password (stops strangers using your OpenAI key).
# APP_PASSWORD = "..."

# Base URL used in QR codes, if auto-detection gets it wrong (e.g. behind a proxy).
# PUBLIC_URL = "https://la-cata.streamlit.app"
